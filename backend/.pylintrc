[MASTER]
ignore=CVS

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-locals,
    no-name-in-module,
    no-self-argument

[REPORTS]
output-format=text

[BASIC]
good-names=i,j,k,ex,Run,_,id,t,r,e

[FORMAT]
max-line-length=120
